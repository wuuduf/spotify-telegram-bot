[bot]
# 推荐通过环境变量 TELEGRAM_BOT_TOKEN 注入
token = ""
api_base = "https://api.telegram.org"
poll_timeout_sec = 30
request_timeout_sec = 180
allowed_chat_ids = []

[votify]
config_path = "/config/config.ini"
workdir = "/app"

[spotify]
cookies_path = "/config/cookies.txt"
search_limit = 8

[runtime]
python_bin = "/usr/local/bin/python"
download_root = "/data/downloads"
temp_root = "/data/temp"
cache_file = "/data/spotify-telegram-cache.json"
keep_downloads = false
max_parallel_jobs = 1
max_pending_jobs = 50
download_timeout_sec = 7200
download_retry_count = 1
download_retry_backoff_sec = 2.0
drop_pending_updates_on_start = true
